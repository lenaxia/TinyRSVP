{
  "version": "1.0",
  "metadata": {
    "name": "Wedding Elegance",
    "category": "card",
    "description": "Elegant wedding invitation with floral design"
  },
  "layout": {
    "mode": "card",
    "cardWidth": "800px",
    "cardMaxWidth": "90vw",
    "backgroundColor": "#f8f9fa"
  },
  "components": [
    {
      "id": "page-background",
      "type": "Background",
      "position": {
        "mode": "absolute",
        "x": "0",
        "y": "0"
      },
      "dimensions": {
        "width": "100%",
        "height": "100%"
      },
      "zIndex": 0,
      "visible": true,
      "content": {
        "color": "#f8f9fa",
        "type": "color"
      }
    },
    {
      "id": "header-image",
      "type": "Image",
      "position": {
        "mode": "relative",
        "order": 1
      },
      "dimensions": {
        "width": "100%",
        "height": "300px"
      },
      "zIndex": 1,
      "visible": true,
      "content": {
        "alt": "Wedding invitation design",
        "objectFit": "cover",
        "objectPosition": "center",
        "src": "{{if .Event.CustomThemeImageURL}}{{.Event.CustomThemeImageURL}}{{else}}/static/images/themes/wedding-elegance-header.svg{{end}}"
      },
      "responsive": {
        "mobile": {
          "height": "200px"
        }
      }
    },
    {
      "id": "title-text",
      "type": "TextBox",
      "position": {
        "mode": "relative",
        "order": 2
      },
      "dimensions": {
        "width": "100%",
        "height": "auto"
      },
      "zIndex": 10,
      "visible": true,
      "content": {
        "color": "#f4c2c2",
        "fontFamily": "Georgia, 'Times New Roman', serif",
        "fontSize": "2.5rem",
        "fontWeight": "700",
        "lineHeight": "1.2",
        "text": "{{.Event.Title}}",
        "textAlign": "center"
      },
      "responsive": {
        "mobile": {
          "fontSize": "1.5rem"
        }
      }
    },
    {
      "id": "date-text",
      "type": "TextBox",
      "position": {
        "mode": "relative",
        "order": 3
      },
      "dimensions": {
        "width": "100%",
        "height": "auto"
      },
      "zIndex": 10,
      "visible": true,
      "content": {
        "color": "#666666",
        "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "fontSize": "1.125rem",
        "lineHeight": "1.5",
        "text": "{{formatDateTime .Event.StartTime}}",
        "textAlign": "center"
      }
    },
    {
      "id": "location-text",
      "type": "TextBox",
      "position": {
        "mode": "relative",
        "order": 4
      },
      "dimensions": {
        "width": "100%",
        "height": "auto"
      },
      "zIndex": 10,
      "visible": true,
      "content": {
        "color": "#666666",
        "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "fontSize": "1.125rem",
        "lineHeight": "1.5",
        "text": "{{.Event.Location}}",
        "textAlign": "center"
      }
    }
  ]
}