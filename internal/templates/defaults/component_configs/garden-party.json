{
  "version": "1.0",
  "metadata": {
    "name": "Garden Party",
    "category": "card",
    "description": "Fresh garden party invitation with floral elements"
  },
  "layout": {
    "mode": "card",
    "cardWidth": "800px",
    "cardMaxWidth": "90vw",
    "backgroundColor": "#f0fdf4"
  },
  "components": [
    {
      "id": "page-background",
      "type": "Background",
      "position": {
        "mode": "absolute",
        "x": "0",
        "y": "0"
      },
      "dimensions": {
        "width": "100%",
        "height": "100%"
      },
      "zIndex": 0,
      "visible": true,
      "content": {
        "gradient": "linear-gradient(135deg, #dcfce7 0%, #f0fdf4 100%)",
        "type": "gradient"
      }
    },
    {
      "id": "header-image",
      "type": "Image",
      "position": {
        "mode": "relative",
        "order": 1
      },
      "dimensions": {
        "width": "100%",
        "height": "300px"
      },
      "zIndex": 1,
      "visible": true,
      "content": {
        "alt": "Garden party design",
        "objectFit": "cover",
        "objectPosition": "center",
        "src": "{{if .Event.CustomThemeImageURL}}{{.Event.CustomThemeImageURL}}{{else}}/static/images/themes/garden-party-header.svg{{end}}"
      },
      "responsive": {
        "mobile": {
          "height": "200px"
        }
      }
    },
    {
      "id": "title-text",
      "type": "TextBox",
      "position": {
        "mode": "relative",
        "order": 2
      },
      "dimensions": {
        "width": "100%",
        "height": "auto"
      },
      "zIndex": 10,
      "visible": true,
      "content": {
        "color": "#166534",
        "fontFamily": "'Palatino Linotype', 'Book Antiqua', Palatino, serif",
        "fontSize": "2.5rem",
        "fontWeight": "600",
        "lineHeight": "1.2",
        "text": "{{.Event.Title}}",
        "textAlign": "center"
      },
      "responsive": {
        "mobile": {
          "fontSize": "2rem"
        }
      }
    },
    {
      "id": "date-text",
      "type": "TextBox",
      "position": {
        "mode": "relative",
        "order": 3
      },
      "dimensions": {
        "width": "100%",
        "height": "auto"
      },
      "zIndex": 10,
      "visible": true,
      "content": {
        "color": "#15803d",
        "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "fontSize": "1.125rem",
        "lineHeight": "1.5",
        "text": "{{formatDateTime .Event.StartTime}}",
        "textAlign": "center"
      }
    },
    {
      "id": "location-text",
      "type": "TextBox",
      "position": {
        "mode": "relative",
        "order": 4
      },
      "dimensions": {
        "width": "100%",
        "height": "auto"
      },
      "zIndex": 10,
      "visible": true,
      "content": {
        "color": "#16a34a",
        "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "fontSize": "1rem",
        "lineHeight": "1.5",
        "text": "{{.Event.Location}}",
        "textAlign": "center"
      }
    }
  ]
}