{
  "version": "1.0",
  "metadata": {
    "name": "Corporate Professional",
    "category": "card",
    "description": "Professional business event invitation"
  },
  "layout": {
    "mode": "card",
    "cardWidth": "800px",
    "cardMaxWidth": "90vw",
    "backgroundColor": "#ffffff"
  },
  "components": [
    {
      "id": "page-background",
      "type": "Background",
      "position": {
        "mode": "absolute",
        "x": "0",
        "y": "0"
      },
      "dimensions": {
        "width": "100%",
        "height": "100%"
      },
      "zIndex": 0,
      "visible": true,
      "content": {
        "color": "#ffffff",
        "type": "color"
      }
    },
    {
      "id": "header-image",
      "type": "Image",
      "position": {
        "mode": "relative",
        "order": 1
      },
      "dimensions": {
        "width": "100%",
        "height": "250px"
      },
      "zIndex": 1,
      "visible": true,
      "content": {
        "alt": "Corporate event design",
        "objectFit": "cover",
        "objectPosition": "center",
        "src": "{{if .Event.CustomThemeImageURL}}{{.Event.CustomThemeImageURL}}{{else}}/static/images/themes/corporate-professional-header.svg{{end}}"
      },
      "responsive": {
        "mobile": {
          "height": "180px"
        }
      }
    },
    {
      "id": "title-text",
      "type": "TextBox",
      "position": {
        "mode": "relative",
        "order": 2
      },
      "dimensions": {
        "width": "100%",
        "height": "auto"
      },
      "zIndex": 10,
      "visible": true,
      "content": {
        "color": "#1a365d",
        "fontFamily": "'Helvetica Neue', Helvetica, Arial, sans-serif",
        "fontSize": "2rem",
        "fontWeight": "600",
        "lineHeight": "1.3",
        "text": "{{.Event.Title}}",
        "textAlign": "center"
      },
      "responsive": {
        "mobile": {
          "fontSize": "1.5rem"
        }
      }
    },
    {
      "id": "date-text",
      "type": "TextBox",
      "position": {
        "mode": "relative",
        "order": 3
      },
      "dimensions": {
        "width": "100%",
        "height": "auto"
      },
      "zIndex": 10,
      "visible": true,
      "content": {
        "color": "#4a5568",
        "fontFamily": "'Helvetica Neue', Helvetica, Arial, sans-serif",
        "fontSize": "1.125rem",
        "lineHeight": "1.5",
        "text": "{{formatDateTime .Event.StartTime}}",
        "textAlign": "center"
      }
    },
    {
      "id": "location-text",
      "type": "TextBox",
      "position": {
        "mode": "relative",
        "order": 4
      },
      "dimensions": {
        "width": "100%",
        "height": "auto"
      },
      "zIndex": 10,
      "visible": true,
      "content": {
        "color": "#718096",
        "fontFamily": "'Helvetica Neue', Helvetica, Arial, sans-serif",
        "fontSize": "1rem",
        "lineHeight": "1.5",
        "text": "{{.Event.Location}}",
        "textAlign": "center"
      }
    }
  ]
}