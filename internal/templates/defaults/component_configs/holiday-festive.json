{
  "version": "1.0",
  "metadata": {
    "name": "Holiday Festive",
    "category": "card",
    "description": "Festive holiday celebration invitation"
  },
  "layout": {
    "mode": "card",
    "cardWidth": "800px",
    "cardMaxWidth": "90vw",
    "backgroundColor": "#f0f9ff"
  },
  "components": [
    {
      "id": "page-background",
      "type": "Background",
      "position": {
        "mode": "absolute",
        "x": "0",
        "y": "0"
      },
      "dimensions": {
        "width": "100%",
        "height": "100%"
      },
      "zIndex": 0,
      "visible": true,
      "content": {
        "gradient": "linear-gradient(135deg, #e0f2fe 0%, #dbeafe 100%)",
        "type": "gradient"
      }
    },
    {
      "id": "header-image",
      "type": "Image",
      "position": {
        "mode": "relative",
        "order": 1
      },
      "dimensions": {
        "width": "100%",
        "height": "300px"
      },
      "zIndex": 1,
      "visible": true,
      "content": {
        "alt": "Holiday festive design",
        "objectFit": "cover",
        "objectPosition": "center",
        "src": "{{if .Event.CustomThemeImageURL}}{{.Event.CustomThemeImageURL}}{{else}}/static/images/themes/holiday-festive-header.svg{{end}}"
      },
      "responsive": {
        "mobile": {
          "height": "200px"
        }
      }
    },
    {
      "id": "title-text",
      "type": "TextBox",
      "position": {
        "mode": "relative",
        "order": 2
      },
      "dimensions": {
        "width": "100%",
        "height": "auto"
      },
      "zIndex": 10,
      "visible": true,
      "content": {
        "color": "#dc2626",
        "fontFamily": "'Brush Script MT', cursive",
        "fontSize": "2.5rem",
        "fontWeight": "400",
        "lineHeight": "1.2",
        "text": "{{.Event.Title}}",
        "textAlign": "center",
        "textShadow": "2px 2px 4px rgba(0,0,0,0.1)"
      },
      "responsive": {
        "mobile": {
          "fontSize": "2rem"
        }
      }
    },
    {
      "id": "date-text",
      "type": "TextBox",
      "position": {
        "mode": "relative",
        "order": 3
      },
      "dimensions": {
        "width": "100%",
        "height": "auto"
      },
      "zIndex": 10,
      "visible": true,
      "content": {
        "color": "#166534",
        "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "fontSize": "1.125rem",
        "fontWeight": "600",
        "lineHeight": "1.5",
        "text": "{{formatDateTime .Event.StartTime}}",
        "textAlign": "center"
      }
    },
    {
      "id": "location-text",
      "type": "TextBox",
      "position": {
        "mode": "relative",
        "order": 4
      },
      "dimensions": {
        "width": "100%",
        "height": "auto"
      },
      "zIndex": 10,
      "visible": true,
      "content": {
        "color": "#065f46",
        "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "fontSize": "1rem",
        "lineHeight": "1.5",
        "text": "{{.Event.Location}}",
        "textAlign": "center"
      }
    }
  ]
}