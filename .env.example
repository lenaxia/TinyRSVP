# ============================================================
# TinyRSVP Configuration
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# Lines starting with # are comments.
# ============================================================


# ------------------------------------------------------------
# SERVER  (required)
# ------------------------------------------------------------

# The URL guests and admins will use to reach TinyRSVP.
# Must match the hostname/path behind your reverse proxy.
SERVER_BASE_URL=https://rsvp.example.com

# Bind address and port inside the container (rarely needs changing).
SERVER_HOST=0.0.0.0
SERVER_PORT=8080


# ------------------------------------------------------------
# DATABASE  (required)
# ------------------------------------------------------------

DATABASE_TYPE=sqlite
DATABASE_PATH=/data/tinyrsvp.db

# Optional tuning (defaults shown)
# DATABASE_MAX_OPEN_CONNS=25
# DATABASE_MAX_IDLE_CONNS=25
# DATABASE_MAX_LIFETIME=5m


# ------------------------------------------------------------
# TOKEN SECURITY  (required)
# ------------------------------------------------------------
# TinyRSVP will refuse to start if TOKEN_SECRET is not set.
#
# This secret signs every invite token. If you change or lose it,
# all existing invite links will stop working.
#
# Generate a value with:
#   openssl rand -hex 32
#
TOKEN_SECRET=


# ------------------------------------------------------------
# AUTHENTICATION  (choose one: OIDC or Forward Auth)
# ------------------------------------------------------------
# TinyRSVP has no local user accounts. Admins authenticate via
# either an OIDC provider (Authentik, Keycloak, etc.) or a
# reverse proxy that injects trusted headers (Traefik + Authelia,
# Caddy + authz middleware, etc.).

# -- Option A: OIDC --
# NOTE: OIDC is implemented (go-oidc library, full login/callback/logout flow)
# but has NOT been integration-tested against a real provider in beta.
# Unit tests pass with a mock provider. If you try it, please report results.
# Forward Auth (Option B) is the tested path for this beta release.
# OIDC_ENABLED=true
# OIDC_ISSUER_URL=https://auth.example.com/application/o/tinyrsvp/
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URL=https://rsvp.example.com/auth/oidc/callback
# OIDC_SKIP_VERIFY=false   # set true only for self-signed certs in dev

# -- Option B: Forward Auth (Traefik + Authelia, Caddy, etc.) --
FORWARD_AUTH_ENABLED=true
FORWARD_AUTH_USER_HEADER=X-Forwarded-User
FORWARD_AUTH_EMAIL_HEADER=X-Forwarded-Email
# Comma-separated list of IPs allowed to send forward-auth headers.
# Add your reverse proxy's container/host IP here.
FORWARD_AUTH_TRUSTED_IPS=127.0.0.1,172.17.0.1,172.18.0.1,172.19.0.1,172.20.0.1


# ------------------------------------------------------------
# EMAIL / SMTP  (required for sending invitations)
# ------------------------------------------------------------

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-username
SMTP_PASSWORD=your-password
EMAIL_FROM=noreply@example.com
# EMAIL_FROM_NAME=TinyRSVP   # Optional display name


# ------------------------------------------------------------
# STORAGE  (local filesystem only in v0)
# ------------------------------------------------------------

STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/data/uploads

# -- S3-compatible storage (NOT YET IMPLEMENTED — planned for v1) --
# STORAGE_TYPE=s3
# STORAGE_S3_BUCKET=tinyrsvp
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT=https://s3.amazonaws.com   # omit for AWS


# ------------------------------------------------------------
# SECURITY  (optional — sensible defaults shown)
# ------------------------------------------------------------

# SECURITY_SESSION_DURATION=24h
# SECURITY_TOKEN_EXPIRY=720h   # 30 days
# SECURITY_HMAC_SECRET=        # auto-generated if not set (does not need to persist)


# ------------------------------------------------------------
# LOGGING  (optional)
# ------------------------------------------------------------

# LOG_LEVEL=INFO   # DEBUG | INFO | WARN | ERROR


# ------------------------------------------------------------
# TOKEN HASHING  (optional — leave at default)
# ------------------------------------------------------------
# When true (default), invite tokens are stored as HMAC hashes.
# Only set to false if you need plain-text tokens for debugging.

# TOKEN_HASHING_ENABLED=true


# ------------------------------------------------------------
# EMAIL PROCESSOR  (optional — sensible defaults shown)
# ------------------------------------------------------------

# EMAIL_PROCESSOR_BATCH_SIZE=50
# EMAIL_PROCESSOR_POLL_INTERVAL=60s
